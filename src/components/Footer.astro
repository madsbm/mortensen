---
import BrandIcon from './BrandIcon.astro';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../site';

interface Props {
	lang: Lang;
	/** Continue a dark section that ends the page. */
	inverted?: boolean;
}

const t = useTranslations(Astro.props.lang);
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', { inverted: Astro.props.inverted }]}>
	<div class="container inner">
		<p class="mono">© {year} {site.name}</p>
		{
			site.links.length > 0 && (
				<ul class="mono">
					{site.links.map((link) => (
						<li>
							<a href={link.href} rel="me noopener">
								<BrandIcon name={link.icon} />
								{link.label}
							</a>
						</li>
					))}
				</ul>
			)
		}
		<a class="mono top" href="#main">{t.footer.top} ↑</a>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		color: var(--ink-3);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
		padding-block: 28px 32px;
	}

	ul {
		display: flex;
		gap: 20px;
	}

	a {
		transition: color 200ms ease;
	}

	ul a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	@media (hover: hover) and (pointer: fine) {
		a:hover {
			color: var(--ink);
		}
	}
</style>
