---
import CanvasFx from './CanvasFx.astro';
import { encode } from '../lib/obfuscate';
import { site } from '../site';

// A fresh key per build, so the encoded string changes between deploys too.
const key = crypto.randomUUID().slice(0, 8);
const encoded = encode(site.email, key);
---

<div class="contact-grid">
	<div class="intro">
		<p class="lead">Have a role, a project or a hard problem? Send me a note.</p>
		<p class="note">
			The form opens a prefilled email in your own mail app. Nothing is sent from this site.
		</p>
		<div class="address" data-address data-mx={encoded} data-mk={key}>
			<button class="button button-ghost" type="button" data-reveal>Show email address</button>
			<noscript><p class="note">Enable JavaScript to see the address.</p></noscript>
		</div>
	</div>

	<CanvasFx
		effect="ripple"
		nativeOnly
		media="(prefers-reduced-motion: no-preference)"
		class="form-fx"
		options={{ trigger: 'none', amplitude: 0.35, refraction: 40, dispersion: 0.2, shine: 0.2, decay: 1.4 }}
	>
		<form class="form" data-contact-form data-mx={encoded} data-mk={key}>
			<div class="field">
				<label for="contact-name">Name</label>
				<input id="contact-name" name="name" type="text" autocomplete="name" required />
			</div>
			<div class="field">
				<label for="contact-subject">Subject <span>Optional</span></label>
				<input id="contact-subject" name="subject" type="text" />
			</div>
			<div class="field">
				<label for="contact-message">Message</label>
				<textarea id="contact-message" name="message" rows="6" required></textarea>
			</div>
			<div class="foot">
				<button class="button button-solid" type="submit">
					Open in mail app <span class="arrow" aria-hidden="true">→</span>
				</button>
				<p class="status mono" role="status" aria-live="polite" data-status></p>
			</div>
		</form>
	</CanvasFx>
</div>

<script>
	import { setUpContact } from '../scripts/contact';
	setUpContact();
</script>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		gap: clamp(40px, 6vw, 96px);
		padding-top: clamp(32px, 4vw, 48px);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.lead {
		max-width: 16ch;
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.note {
		max-width: 38ch;
		color: var(--ink-2);
	}

	.address {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		min-height: 44px;
		margin-top: 8px;
	}

	.address :global(.email) {
		font-size: 1.0625rem;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
		transition: text-decoration-color 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.address :global(.email:hover) {
			text-decoration-color: var(--ink);
		}
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: clamp(20px, 3vw, 32px);
		border-radius: 20px;
		background: var(--bg-raised);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	label {
		font-size: 0.875rem;
		font-weight: 500;
	}

	label span {
		margin-left: 6px;
		color: var(--ink-3);
		font-weight: 400;
	}

	input,
	textarea {
		width: 100%;
		padding: 12px 14px;
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		background: var(--bg);
		font-size: 1rem;
		line-height: 1.5;
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease;
	}

	textarea {
		min-height: 9.5rem;
		resize: vertical;
	}

	input:focus-visible,
	textarea:focus-visible {
		border-color: var(--ink);
		outline: none;
		box-shadow: 0 0 0 3px rgb(11 11 12 / 0.08);
	}

	input:user-invalid,
	textarea:user-invalid {
		border-color: var(--accent-ink);
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
		margin-top: 4px;
	}

	.status {
		color: var(--ink-2);
	}

	.status :global(button) {
		padding: 0;
		border: 0;
		background: none;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
