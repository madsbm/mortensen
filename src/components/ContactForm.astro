---
import CanvasFx from './CanvasFx.astro';
import BrandIcon from './BrandIcon.astro';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { encode } from '../lib/obfuscate';
import { site } from '../site';

interface Props {
	lang: Lang;
}

const t = useTranslations(Astro.props.lang).contact;

// A fresh key per build, so the encoded string changes between deploys too.
const key = crypto.randomUUID().slice(0, 8);
const encoded = encode(site.email, key);
---

<div class="contact-grid">
	<div class="intro">
		<p class="lead">{t.lead}</p>
		<p class="note">{t.note}</p>
		<div class="address" data-address data-mx={encoded} data-mk={key}>
			<button class="button button-ghost" type="button" data-reveal>{t.reveal}</button>
			<noscript><p class="note">{t.noscript}</p></noscript>
		</div>
		<ul class="elsewhere mono" aria-label={t.profiles}>
			{
				site.links.map((link) => (
					<li>
						<a href={link.href} rel="me noopener">
							<BrandIcon name={link.icon} />
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<CanvasFx
		effect="ripple"
		nativeOnly
		media="(prefers-reduced-motion: no-preference)"
		backdrop="var(--bg-raised)"
		class="form-fx"
		options={{ trigger: 'none', amplitude: 0.35, refraction: 40, dispersion: 0.2, shine: 0.2, decay: 1.4 }}
	>
		<form
			class="form"
			data-contact-form
			data-mx={encoded}
			data-mk={key}
			data-strings={JSON.stringify(t.client)}
		>
			<div class="row">
				<div class="field">
					<label for="contact-name">{t.name}</label>
					<input id="contact-name" name="name" type="text" autocomplete="name" required />
				</div>
				<div class="field">
					<label for="contact-subject">{t.subject} <span>{t.optional}</span></label>
					<input id="contact-subject" name="subject" type="text" />
				</div>
			</div>
			<div class="field">
				<label for="contact-message">{t.message}</label>
				<textarea id="contact-message" name="message" rows="4" required></textarea>
			</div>
			<div class="foot">
				<button class="button button-solid" type="submit">
					{t.submit} <span class="arrow" aria-hidden="true">→</span>
				</button>
				<p class="status mono" role="status" aria-live="polite" data-status></p>
			</div>
		</form>
	</CanvasFx>
</div>

<script>
	import { setUpContact } from '../scripts/contact';
	setUpContact();
</script>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		gap: clamp(40px, 6vw, 96px);
		padding-top: clamp(32px, 4vw, 48px);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.lead {
		max-width: 16ch;
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.note {
		max-width: 38ch;
		color: var(--ink-2);
	}

	.address {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		min-height: 44px;
		margin-top: 8px;
	}

	.address :global(.email) {
		font-size: 1.0625rem;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
		transition: text-decoration-color 200ms ease;
	}

	.elsewhere {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-top: 4px;
	}

	.elsewhere a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink-2);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
		transition:
			color 200ms ease,
			text-decoration-color 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.address :global(.email:hover),
		.elsewhere a:hover {
			color: var(--ink);
			text-decoration-color: var(--ink);
		}
	}

	/* The ripple redraws the whole box, so clip it to the form's corners. */
	.contact-grid :global(.form-fx) {
		align-self: start;
		border-radius: 20px;
		overflow: clip;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: clamp(20px, 3vw, 32px);
		border-radius: 20px;
		background: var(--bg-raised);
		box-shadow: inset 0 0 0 1px var(--line);
	}

	/* Side by side where there's room, stacked on narrow screens. */
	.row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
		gap: 20px 16px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	label {
		font-size: 0.875rem;
		font-weight: 500;
	}

	label span {
		margin-left: 6px;
		color: var(--ink-3);
		font-weight: 400;
	}

	input,
	textarea {
		width: 100%;
		padding: 12px 14px;
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		background: var(--bg);
		font-size: 1rem;
		line-height: 1.5;
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease;
	}

	textarea {
		min-height: 7.5rem;
		resize: vertical;
	}

	input:focus-visible,
	textarea:focus-visible {
		border-color: var(--ink);
		outline: none;
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--ink) 12%, transparent);
	}

	input:user-invalid,
	textarea:user-invalid {
		border-color: var(--accent-ink);
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
		margin-top: 4px;
	}

	.status {
		color: var(--ink-2);
	}

	.status :global(button) {
		padding: 0;
		border: 0;
		background: none;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
