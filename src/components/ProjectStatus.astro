---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
	lang: Lang;
	status: CollectionEntry<'projects'>['data']['status'];
}

const { lang, status } = Astro.props;
const t = useTranslations(lang);
---

<span class="status mono" data-state={status}>
	<span class="dot" aria-hidden="true"></span>{t.status[status]}
</span>

<style>
	.status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink-2);
		font-size: 0.75rem;
		white-space: nowrap;
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--ink-3);
	}

	[data-state='active'] .dot {
		background: var(--accent);
		box-shadow: 0 0 0 3px rgb(255 79 31 / 0.16);
	}

	[data-state='complete'] .dot {
		background: var(--ink);
	}

	[data-state='discontinued'] {
		color: var(--ink-3);
	}

	[data-state='discontinued'] .dot {
		background: transparent;
		box-shadow: inset 0 0 0 1.5px var(--ink-3);
	}
</style>
