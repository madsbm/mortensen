---
import type { CollectionEntry } from 'astro:content';

interface Props {
	status: CollectionEntry<'projects'>['data']['status'];
}

const { status } = Astro.props;
const state = status.toLowerCase().replace(/\s+/g, '-');
---

<span class="status mono" data-state={state}>
	<span class="dot" aria-hidden="true"></span>{status}
</span>

<style>
	.status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink-2);
		font-size: 0.75rem;
		white-space: nowrap;
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--ink-3);
	}

	[data-state='in-development'] .dot {
		background: var(--accent);
		box-shadow: 0 0 0 3px rgb(255 79 31 / 0.16);
	}

	[data-state='complete'] .dot {
		background: var(--ink);
	}

	[data-state='discontinued'] {
		color: var(--ink-3);
	}

	[data-state='discontinued'] .dot {
		background: transparent;
		box-shadow: inset 0 0 0 1.5px var(--ink-3);
	}
</style>
