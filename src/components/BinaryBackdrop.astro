---
import CanvasFx from './CanvasFx.astro';
---

<div class="backdrop" aria-hidden="true">
	<CanvasFx
		effect="asciify"
		sizing="fill"
		pointer="window"
		media="(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
		class="backdrop-fx"
		options={{
			charset: 'binary',
			radius: 0.32,
			softness: 1,
			scale: 2,
			spacing: 1,
			background: 'auto',
			backgroundOpacity: 0,
			contrast: 1.7,
			brightness: 0.45,
			glow: 0,
			aberration: 0.3,
			followSpeed: 4,
		}}
	>
		<canvas class="art" data-backdrop-art></canvas>
	</CanvasFx>
</div>

<script>
	import { paintBackdrop } from '../scripts/backdrop';
	paintBackdrop();
</script>

<style>
	.backdrop {
		/* Where the text starts: the content edge of a .container. */
		--text-edge: max(var(--gutter), (100% - var(--max)) / 2);
		/* Mask layers used by backdrop.ts. Digits may only stand out in the
		   margins (fading in gently from the text edge) and away from the rail. */
		--backdrop-margins: linear-gradient(
			to right,
			#000 calc(var(--text-edge) - 160px),
			transparent var(--text-edge),
			transparent calc(100% - var(--text-edge)),
			#000 calc(100% - var(--text-edge) + 160px)
		);
		--backdrop-rail: linear-gradient(#000 0 0);

		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	/* Matches ProfileRail.astro: shown from 1100px, 40px wide and 20px from
	   the left, about 190px tall. */
	@media (min-width: 1100px) {
		.backdrop {
			--backdrop-rail: radial-gradient(ellipse 160px 420px at 40px 100%, transparent 55%, #000);
		}
	}

	.backdrop :global(.backdrop-fx) {
		height: 100%;
	}

	/* The artwork only exists for the effect to read. A veil sits between it
	   and the effect's output, so the page stays white and only the binary
	   glyphs around the cursor show. The effect still samples the artwork:
	   the veil is outside the captured content either way. */
	.backdrop :global(.backdrop-fx)::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background: var(--bg);
	}

	/* The effect boosts glyph contrast for legibility; here the digits are
	   texture, so they're knocked back. Without mask compositing they all get
	   the faintest level (0.22 × FAINT in backdrop.ts). */
	.backdrop :global(.backdrop-fx .fx-output) {
		z-index: 2;
		opacity: 0.035;
	}

	@supports (mask-composite: intersect) {
		.backdrop :global(.backdrop-fx .fx-output) {
			opacity: 0.22;
			mask-image: var(--backdrop-mask);
			mask-composite: var(--backdrop-composite);
		}
	}

	.art {
		width: 100%;
		height: 100%;
	}
</style>
