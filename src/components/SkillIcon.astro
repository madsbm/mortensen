interface Props {
	name: string;
	class?: string;
}

const { name, class: className } = Astro.props;
const icon = icons[name];
if (!icon) throw new Error(`No skill icon "${name}"`);
---

{
	'text' in icon ? (
		<span class:list={['skill-icon', 'text', className]} data-long={icon.text.length > 3 ? '' : undefined} aria-hidden="true">
			{icon.text}
		</span>
	) : (
		<svg class:list={['skill-icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
			{'path' in icon ? (
				<path d={icon.path} fill="currentColor" />
			) : (
				<g
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					set:html={icon.stroke}
				/>
			)}
		</svg>
	)
}

<style>
	/* Sized by the font size, like BrandIcon. Text is set to read at about
	   the same size as the logos, and never below what's legible. */
	.skill-icon {
		flex: none;
		width: 1em;
		height: 1em;
	}

	.text {
		display: grid;
		place-items: center;
		width: auto;
		font-family: var(--font-mono);
		font-size: max(0.64em, 9px);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.text[data-long] {
		font-size: max(0.5em, 8px);
	}
</style>
