---
import Base from '../../layouts/Base.astro';
import ProjectCover from '../ProjectCover.astro';
import ProjectStatus from '../ProjectStatus.astro';
import ContactForm from '../ContactForm.astro';
import Footer from '../Footer.astro';
import BrandIcon from '../BrandIcon.astro';
import SkillGrid from '../SkillGrid.astro';
import { projectPath, sections, type Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getProjects, pad, repoName } from '../../lib/projects';
import { site } from '../../site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const slug = sections[lang];
const projects = await getProjects(lang);
// Projects shown before the list is expanded.
const shown = 2;

// Structured data for search engines. The email address stays out of it.
const person = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	url: Astro.site,
	jobTitle: t.meta.role,
	worksFor: { '@type': 'Organization', name: 'Side-Walk ApS' },
	address: { '@type': 'PostalAddress', addressCountry: 'DK' },
	sameAs: site.links.map((link) => link.href),
});
---

<Base lang={lang} spy footer={false}>
	<script slot="head" type="application/ld+json" set:html={person} />
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero-inner">
			<div class="hero-top" data-backdrop-zone>
				<SkillGrid lang={lang} />
				<div class="hero-meta">
					<ul class="profiles mono" aria-label={t.contact.profiles}>
						{
							site.links.map((link) => (
								<li>
									<a href={link.href} rel="me noopener">
										<BrandIcon name={link.icon} />
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
					<p class="eyebrow mono"><span class="dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
				</div>
			</div>
			<h1 id="hero-title" class="display">{site.name}</h1>
			<div class="hero-foot">
				<p class="lede">{t.hero.lede}</p>
				<div class="actions">
					<a class="button button-solid" href={`#${slug.work}`}>
						{t.hero.work} <span class="arrow" aria-hidden="true">↓</span>
					</a>
					<a class="button button-ghost" href={`#${slug.contact}`}>{t.hero.contact}</a>
				</div>
			</div>
		</div>
	</section>

	<section id={slug.work} class="container section" data-section={slug.work} aria-labelledby="work-title">
		<div class="section-head">
			<h2 id="work-title">{t.work.title}</h2>
			<span class="mono">{t.work.count(pad(projects.length))}</span>
		</div>

		<ol id="projects" class="projects" data-projects>
			{
				projects.map((project, i) => (
					<li class="project" data-extra={i >= shown ? '' : undefined}>
						<span class="num mono vt" style={`--vt: num-${project.id}`} data-vt-project={project.id}>
							{pad(project.order)}
						</span>
						<div class="project-text">
							<h3 class="project-title">
								<a href={projectPath(lang, project.id)}>
									<span class="vt" style={`--vt: title-${project.id}`} data-vt-project={project.id}>
										{project.title}
									</span>
								</a>
							</h3>
							<ProjectStatus lang={lang} status={project.status} />
							<p class="tagline">{project.tagline}</p>
							<ul class="tags mono" aria-label={t.work.topics}>
								{project.tags.map((tag) => <li>{tag}</li>)}
							</ul>
							<div class="actions-row">
								<span class="open" aria-hidden="true">
									{t.work.open} <span class="arrow">→</span>
								</span>
								{project.links.map((link) => (
									<a class="source mono" href={link.href} rel="noopener">
										<BrandIcon name="github" label="GitHub" />
										{repoName(link.href)}
									</a>
								))}
							</div>
						</div>
						<ProjectCover lang={lang} id={project.id} kind={project.cover} class="project-cover" />
					</li>
				))
			}
		</ol>
		{
			projects.length > shown && (
				<div class="more" data-projects-more hidden>
					<button class="button button-ghost" type="button" aria-controls="projects" aria-expanded="false">
						{t.work.more(projects.length - shown)} <span class="arrow" aria-hidden="true">↓</span>
					</button>
				</div>
			)
		}
		<script is:inline>
			// Collapse the list before it paints, so it never jumps. Without
			// JavaScript every project shows and the button stays hidden.
			{
				const list = document.querySelector('[data-projects]');
				const more = document.querySelector('[data-projects-more]');
				if (more) {
					list.dataset.collapsed = '';
					more.hidden = false;
				}
			}
		</script>
	</section>

	<section id={slug.about} class="container section" data-section={slug.about} aria-labelledby="about-title">
		<div class="section-head">
			<h2 id="about-title">{t.about.title}</h2>
			<span class="mono">{t.about.position}</span>
		</div>

		<div class="about-grid">
			<p class="bio-lead">{t.about.lead}</p>
			<ol class="timeline" aria-label={t.about.timeline.title}>
				{
					t.about.timeline.events.map((event, i, events) => (
						<li class="stop" data-card data-now={i === events.length - 1 ? '' : undefined}>
							<span class="when mono">{event.when}</span>
							<span class="road" aria-hidden="true" />
							<button class="what" type="button">{event.title}</button>
							<ul class="details">
								{event.details.map((detail) => (
									<li>{detail}</li>
								))}
							</ul>
						</li>
					))
				}
				<li class="stop stop-next">
					<span class="when mono">{t.about.timeline.next.when}</span>
					<span class="road" aria-hidden="true" />
					<span class="what">{t.about.timeline.next.title}</span>
					<a class="invite" href={`#${slug.contact}`}>
						{t.about.timeline.next.link} <span class="arrow" aria-hidden="true">→</span>
					</a>
				</li>
			</ol>
		</div>
	</section>

	<!-- The page lifts off this sheet, so the footer sits on it too. -->
	<div id={slug.contact} class="sheet inverted" data-section={slug.contact}>
		<div class="sheet-window">
			<div class="sheet-content">
				<section class="container sheet-inner" aria-labelledby="contact-title">
					<div class="section-head">
						<h2 id="contact-title">{t.contact.title}</h2>
						<span class="mono">{t.contact.location}</span>
					</div>
					<ContactForm lang={lang} />
				</section>
				<Footer lang={lang} />
			</div>
		</div>
	</div>
</Base>

<script>
	import { setUpProjectList } from '../../scripts/projects';
	import { setUpCards } from '../../scripts/cards';
	setUpProjectList();
	setUpCards();
</script>

<style>
	/* ---------------------------------------------------------------- hero */

	.hero-inner {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: clamp(28px, 4vw, 48px);
		min-height: 100svh;
		padding-top: 120px;
		padding-bottom: clamp(40px, 7vh, 88px);
	}

	@media (min-width: 768px) {
		.hero-inner {
			min-height: clamp(640px, 100svh, 980px);
		}
	}

	/* The skill grid shares a line above the name with the profile links and
	   the eyebrow, the grid lined up with the name's first letter and the rest
	   on the right. Where they don't fit side by side, the links and eyebrow
	   drop below the grid, on the left. */
	.hero-top {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 28px 48px;
	}

	.hero-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 14px;
	}

	/* Below the grid (measured: it wraps at this width and under). */
	@media (max-width: 942px) {
		.hero-meta {
			align-items: flex-start;
		}
	}

	/* As in the contact section. */
	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
	}

	.profiles a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink-2);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
		transition:
			color 200ms ease,
			text-decoration-color 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.profiles a:hover {
			color: var(--ink);
			text-decoration-color: var(--ink);
		}
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--ink-2);
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.display {
		font-size: clamp(3rem, 8.4vw, 7.5rem);
		font-weight: 500;
		line-height: 0.94;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}

	.hero-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 28px 48px;
		padding-top: clamp(24px, 3vw, 36px);
		border-top: 1px solid var(--line);
	}

	.lede {
		max-width: 52ch;
		color: var(--ink-2);
		font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	/* ------------------------------------------------------------- sections */

	.section {
		padding-top: clamp(72px, 10vw, 140px);
	}

	/* -------------------------------------------------------------- contact */

	/* A dark sheet the page lifts off, holding the contact section and the
	   footer. */
	.sheet {
		--sheet-radius: clamp(24px, 3.5vw, 44px);
		position: relative;
		margin-top: clamp(72px, 10vw, 140px);
		/* Links to #contact scroll the sheet to the very top (or as far as the
		   page goes), where the reveal below has finished. */
		scroll-margin-top: calc(-1 * var(--header-space));
	}

	/* The page above ends in rounded corners with the sheet showing behind
	   them: the sheet's colour fills each corner outside the curve. */
	.sheet::before,
	.sheet::after {
		content: '';
		position: absolute;
		bottom: 100%;
		width: var(--sheet-radius);
		height: var(--sheet-radius);
		--curve: transparent calc(var(--sheet-radius) - 0.5px), var(--bg) calc(var(--sheet-radius) + 0.5px);
	}

	.sheet::before {
		left: 0;
		background: radial-gradient(circle at 100% 0, var(--curve));
	}

	.sheet::after {
		right: 0;
		background: radial-gradient(circle at 0 0, var(--curve));
	}


	/* Sized by the screen's height, so the sheet fits on a laptop and the
	   reveal can end exactly at the bottom of the page. */
	.sheet-inner {
		padding-block: clamp(32px, 7vh, 80px) clamp(24px, 5vh, 56px);
	}

	/* Phones never fit the whole sheet, so its top scrolls up under the
	   header; keep the heading clear of it. */
	@media (max-width: 860px) {
		.sheet-inner {
			padding-top: var(--header-space);
		}
	}

	/* Parallax: the page lifts off the sheet. The content is sticky to both
	   edges of the screen, so while the page's edge slides up past it, it
	   holds still where it ends up: against the bottom of the screen if it
	   fits, else against the top (top wins), after which it scrolls normally.
	   Sticky positioning moves in step with scrolling, unlike an animation.

	   To have room to hold still, the window reaches a screen's height up
	   under the page (an empty spacer the content can rise into), and that
	   part is clipped away so the content only shows below the page's edge.
	   The sheet is its own formatting context so the window's negative
	   margin doesn't pull the sheet up with it. */
	@media (prefers-reduced-motion: no-preference) {
		.sheet {
			display: flow-root;
		}

		.sheet-window {
			margin-top: -100vh;
			clip-path: inset(100vh 0 0 0);
		}

		.sheet-window::before {
			content: '';
			display: block;
			height: 100vh;
		}

		.sheet-content {
			position: sticky;
			top: 0;
			bottom: 0;
		}
	}

	/* ------------------------------------------------------------- projects */

	/* Set by the inline script until the visitor shows the rest. */
	.projects[data-collapsed] > [data-extra] {
		display: none;
	}

	.more {
		display: flex;
		justify-content: center;
		padding-top: clamp(24px, 3vw, 36px);
	}

	.more[hidden] {
		display: none;
	}

	.project {
		position: relative;
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.3fr);
		gap: clamp(20px, 3vw, 40px);
		padding-block: clamp(28px, 4vw, 48px);
		border-bottom: 1px solid var(--line);
	}

	.num {
		align-self: start;
		padding-top: 0.9em;
		color: var(--ink-3);
		transition: color 200ms ease;
	}

	.project-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.project-title {
		font-size: clamp(2.25rem, 4.6vw, 3.75rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.project-title span {
		display: inline-block;
	}

	/* The title link covers the whole row. */
	.project-title a::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.project-title a:focus-visible {
		outline: none;
	}

	.project:has(a:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 6px;
		border-radius: 8px;
	}

	.tagline {
		max-width: 30ch;
		color: var(--ink-2);
		font-size: 1.125rem;
		line-height: 1.45;
		text-wrap: pretty;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.tags li {
		padding: 4px 10px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-2);
		font-size: 0.75rem;
	}

	.actions-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px 24px;
		margin-top: auto;
		padding-top: 12px;
	}

	.open {
		display: inline-flex;
		gap: 8px;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	/* Sits above the row-wide case study link. */
	.source {
		position: relative;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink-3);
		font-size: 0.75rem;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 3px;
		transition:
			color 200ms ease,
			text-decoration-color 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.source:hover {
			color: var(--ink);
			text-decoration-color: currentColor;
		}
	}

	.open .arrow,
	.project :global(.project-cover .frame) {
		transition: transform 300ms var(--ease-out);
	}

	.project:active :global(.project-cover .frame) {
		transform: scale(0.99);
	}

	@media (hover: hover) and (pointer: fine) {
		.project:hover .num {
			color: var(--accent-ink);
		}

		.project:hover .open .arrow {
			transform: translateX(3px);
		}

		.project:hover :global(.project-cover .frame) {
			transform: scale(1.012);
		}
	}

	@media (max-width: 900px) {
		.project {
			grid-template-columns: minmax(0, 1fr);
			gap: 18px;
		}

		.num {
			padding-top: 0;
		}

		.project :global(.project-cover) {
			order: -1;
		}
	}

	/* ---------------------------------------------------------------- about */

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		align-items: start;
		gap: clamp(32px, 6vw, 96px);
		padding-top: clamp(32px, 4vw, 48px);
	}

	.bio-lead {
		max-width: 22ch;
		color: var(--ink);
		font-size: clamp(1.625rem, 2.8vw, 2.25rem);
		line-height: 1.12;
		letter-spacing: -0.03em;
		font-weight: 500;
	}

	/* -------------------------------------------------------------- timeline */

	/* Stops along a road, top to bottom, sharing one set of columns: year,
	   road, title (as wide as the longest), and room for a card. Each stop's
	   details sit under its title, unless there's a mouse and room for the
	   card (below). */
	.timeline {
		container: timeline / inline-size;
		display: grid;
		grid-template-columns: 3rem 11px fit-content(16rem) minmax(0, 1fr);
		column-gap: 16px;
	}

	.stop {
		position: relative;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		row-gap: 6px;
		padding-bottom: 28px;
		border-radius: 8px;
	}

	.when {
		grid-area: 1 / 1;
		padding-top: 0.25em;
		color: var(--ink-3);
	}

	.road {
		position: relative;
		grid-area: 1 / 2 / span 2;
	}

	.road::before,
	.road::after {
		content: '';
		position: absolute;
	}

	/* The line runs on to the next stop's dot. */
	.road::before {
		top: 11px;
		bottom: -39px;
		left: 5px;
		width: 1px;
		background: var(--line-strong);
	}

	.road::after {
		top: 6px;
		left: 0;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--bg);
		box-shadow: inset 0 0 0 1.5px var(--ink-3);
		transition: box-shadow 200ms ease;
	}

	/* Today, and a dashed line on to whatever is next. */
	.stop[data-now] .road::after {
		background: var(--accent);
		box-shadow: none;
	}

	.stop[data-now] .road::before {
		background: repeating-linear-gradient(var(--line-strong) 0 4px, transparent 4px 8px);
	}

	.stop-next .road::before {
		display: none;
	}

	.stop-next .road::after {
		box-shadow: none;
		outline: 1.5px dashed var(--ink-3);
		outline-offset: -1.5px;
	}

	.what {
		grid-area: 1 / 3 / auto / -1;
		font-size: 1.0625rem;
		font-weight: 500;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	/* The title is what takes focus to open a stop's card, so keyboards can
	   reach it. It looks like the text it is. */
	button.what {
		justify-self: start;
		padding: 0;
		border: 0;
		background: none;
		text-align: start;
		cursor: default;
	}

	.stop-next .what {
		color: var(--ink-2);
	}

	.details,
	.invite {
		grid-area: 2 / 3 / auto / -1;
	}

	.details {
		display: flex;
		flex-direction: column;
		gap: 4px;
		color: var(--ink-2);
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.invite {
		justify-self: start;
		display: inline-flex;
		gap: 8px;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
		transition: text-decoration-color 200ms ease;
	}

	.invite .arrow {
		transition: transform 200ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.invite:hover {
			text-decoration-color: currentColor;
		}

		.invite:hover .arrow {
			transform: translateX(3px);
		}

		/* With a mouse and room beside the titles, the details move into a card
		   there that opens on hover or focus. Cards only cover the empty
		   column, so the pointer can still move straight down the titles. */
		@container timeline (min-width: 520px) {
			.what {
				grid-column: 3;
			}

			.details {
				position: absolute;
				grid-area: 1 / 4;
				top: -10px;
				left: 0;
				z-index: 3;
				width: max-content;
				max-width: 100%;
				padding: 12px 14px;
				border-radius: 14px;
				background: var(--bg);
				box-shadow:
					var(--pill-shadow),
					inset 0 0 0 1px var(--pill-line);
				font-size: 0.875rem;
				line-height: 1.45;
				opacity: 0;
				pointer-events: none;
				transform: translateX(-6px) scale(0.97);
				transform-origin: left top;
				transition:
					opacity 150ms ease,
					transform 150ms var(--ease-out);
			}

			.details li:first-child {
				color: var(--ink);
			}

			.stop:is(:hover, :focus-within):not([data-dismissed]) .details {
				opacity: 1;
				pointer-events: auto;
				transform: none;
				transition-duration: 200ms;
			}

			.stop:is(:hover, :focus-within):not([data-now], .stop-next) .road::after {
				box-shadow: inset 0 0 0 1.5px var(--ink);
			}
		}
	}

	.what:focus-visible {
		outline: none;
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.details {
			transform: none !important;
		}
	}

	@media (max-width: 860px) {
		.about-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
