---
// Wraps live HTML in a Canvas UI effect (https://canvasui.dev). The markup
// renders as plain HTML; src/scripts/fx.ts upgrades it in the browser, moving
// the content into an html-in-canvas source canvas where that API exists.

interface Props {
	effect: 'glass' | 'ripple';
	options?: Record<string, unknown>;
	/** Only mount when this media query matches. */
	media?: string;
	/** `fill`: the wrapper's height comes from CSS. `fit`: it follows the content. */
	sizing?: 'fill' | 'fit';
	/** Skip the effect entirely when html-in-canvas is unavailable. */
	nativeOnly?: boolean;
	class?: string;
}

const { effect, options = {}, media, sizing = 'fit', nativeOnly = false, class: className } = Astro.props;
---

<div
	class:list={['fx', className]}
	data-fx={effect}
	data-fx-options={JSON.stringify(options)}
	data-fx-media={media}
	data-fx-sizing={sizing}
	data-fx-native-only={nativeOnly ? '' : undefined}
>
	<canvas class="fx-source" hidden></canvas>
	<div class="fx-content">
		<div class="fx-inner"><slot /></div>
	</div>
	<canvas class="fx-output" aria-hidden="true"></canvas>
</div>

<script>
	import { mountEffects } from '../scripts/fx';
	mountEffects();
</script>

<style>
	.fx {
		position: relative;
	}

	.fx-source,
	.fx-output {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.fx-source[hidden] {
		display: none;
	}

	.fx-output {
		pointer-events: none;
	}

	/* Effects sample the captured pixels, so the content needs an opaque
	   backdrop or refractions pull in transparent black. */
	.fx-content {
		position: relative;
		width: 100%;
		height: 100%;
		background: var(--bg);
	}

	.fx[data-fx-sizing='fill'] .fx-inner {
		height: 100%;
	}
</style>
