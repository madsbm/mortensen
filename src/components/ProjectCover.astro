---
import TosCover from './covers/TosCover.astro';
import RelayCover from './covers/RelayCover.astro';
import PacketPlotsCover from './covers/PacketPlotsCover.astro';
import LectimateCover from './covers/LectimateCover.astro';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
	id: string;
	kind: 'tos' | 'relay' | 'packetplots' | 'lectimate';
	class?: string;
}

const { lang, id, kind, class: className } = Astro.props;
---

<div class:list={['cover', 'vt', className]} style={`--vt: cover-${id}`} data-vt-project={id}>
	<div class="frame">
		{kind === 'tos' && <TosCover />}
		{kind === 'relay' && <RelayCover lang={lang} />}
		{kind === 'packetplots' && <PacketPlotsCover lang={lang} />}
		{kind === 'lectimate' && <LectimateCover lang={lang} />}
	</div>
</div>

<style>
	/* Everything inside is sized in container units, so the small list cover
	   and the large case-study cover are exact enlargements of each other and
	   the page transition morph lines up. */
	.cover {
		container-type: inline-size;
		aspect-ratio: 16 / 10;
	}

	.frame {
		position: relative;
		height: 100%;
		overflow: hidden;
		border-radius: 1.6cqi;
		isolation: isolate;
	}

	.frame::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px rgb(11 11 12 / 0.06);
		pointer-events: none;
	}
</style>
