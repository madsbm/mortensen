---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import ProjectStatus from '../../components/ProjectStatus.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	const at = (i: number) => projects[(i + projects.length) % projects.length];
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, previous: at(i - 1), next: at(i + 1) },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	previous: CollectionEntry<'projects'>;
	next: CollectionEntry<'projects'>;
}

const { project, previous, next } = Astro.props;
const { id, data } = project;
const { Content } = await render(project);
const pad = (n: number) => String(n).padStart(2, '0');

// Each title can only carry its transition name once per page, so with fewer
// than three projects the pager drops duplicates (and the current project).
const pager = [
	{ rel: 'prev', label: 'Previous', entry: previous },
	{ rel: 'next', label: 'Next', entry: next },
].filter(({ entry }, i, all) => entry.id !== id && all.findIndex((p) => p.entry.id === entry.id) === i);
---

<Base
	title={data.title}
	description={data.summary}
	project={id}
	crumbs={[
		{ label: 'work', href: '/#work' },
		{ label: id, href: `/work/${id}`, current: true },
	]}
>
	<article class="container case">
		<header class="case-head">
			<span class="num mono vt" style={`--vt: num-${id}`} data-vt-project={id}>{pad(data.order)}</span>
			<h1><span class="vt" style={`--vt: title-${id}`} data-vt-project={id}>{data.title}</span></h1>
			<p class="tagline">{data.tagline}</p>
			{
				data.notice && (
					<p class="notice" role="note">
						<ProjectStatus status={data.status} />
						<span>{data.notice}</span>
					</p>
				)
			}
		</header>

		<ProjectCover id={id} kind={data.cover} class="case-cover" />

		<div class="case-body">
			<dl class="facts">
				<div>
					<dt class="mono">Status</dt>
					<dd><ProjectStatus status={data.status} /></dd>
				</div>
				{
					data.role && (
						<div>
							<dt class="mono">Role</dt>
							<dd>{data.role}</dd>
						</div>
					)
				}
				{
					data.stack.length > 0 && (
						<div>
							<dt class="mono">Stack</dt>
							<dd>{data.stack.join(', ')}</dd>
						</div>
					)
				}
				{
					data.links.length > 0 && (
						<div>
							<dt class="mono">Links</dt>
							<dd>
								{data.links.map((link) => (
									<a href={link.href} rel="noopener">
										{link.label} ↗
									</a>
								))}
							</dd>
						</div>
					)
				}
			</dl>

			<div class="prose">
				<p class="summary">{data.summary}</p>
				<Content />
			</div>
		</div>
	</article>

	{
		pager.length > 0 && (
			<nav class="container pager" aria-label="More projects">
				{pager.map(({ rel, label, entry }) => (
					<a href={`/work/${entry.id}`} rel={rel} class={rel}>
						<span class="mono label">
							{label} · {pad(entry.data.order)}
						</span>
						<span class="pager-title">
							{rel === 'prev' && <span class="arrow" aria-hidden="true">←</span>}
							<span class="vt" style={`--vt: title-${entry.id}`} data-vt-project={entry.id}>
								{entry.data.title}
							</span>
							{rel === 'next' && <span class="arrow" aria-hidden="true">→</span>}
						</span>
					</a>
				))}
			</nav>
		)
	}
</Base>

<style>
	.case {
		padding-top: clamp(120px, 16vw, 180px);
	}

	.case-head {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		column-gap: clamp(20px, 3vw, 40px);
		row-gap: 20px;
		padding-bottom: clamp(32px, 5vw, 56px);
	}

	.num {
		padding-top: 1.1em;
		color: var(--ink-3);
	}

	h1 {
		font-size: clamp(3.25rem, 10vw, 8.5rem);
		font-weight: 500;
		line-height: 0.92;
		letter-spacing: -0.055em;
	}

	h1 span {
		display: inline-block;
	}

	.tagline {
		grid-column: 2;
		max-width: 34ch;
		color: var(--ink-2);
		font-size: clamp(1.25rem, 2vw, 1.625rem);
		line-height: 1.35;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	.notice {
		grid-column: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
		justify-self: start;
		padding: 12px 18px;
		border: 1px solid var(--line-strong);
		border-radius: 14px;
		background: var(--bg-raised);
		color: var(--ink-2);
		font-size: 0.9375rem;
	}

	.case-body {
		display: grid;
		grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
		gap: clamp(32px, 6vw, 96px);
		padding-top: clamp(40px, 6vw, 72px);
	}

	.facts {
		position: sticky;
		top: var(--header-space);
		align-self: start;
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--line);
	}

	.facts div {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-block: 14px;
		border-bottom: 1px solid var(--line);
	}

	.facts dt {
		color: var(--ink-3);
	}

	.facts dd {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		line-height: 1.5;
	}

	.facts a {
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 3px;
	}

	.prose {
		max-width: 68ch;
		color: var(--ink-2);
		font-size: 1.0625rem;
		line-height: 1.7;
	}

	.prose .summary {
		margin-bottom: 1.5em;
		color: var(--ink);
		font-size: clamp(1.25rem, 1.8vw, 1.4375rem);
		line-height: 1.45;
		letter-spacing: -0.015em;
	}

	.prose :global(h2) {
		margin-top: 2.4em;
		margin-bottom: 0.7em;
		color: var(--ink);
		font-size: 1.5rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.prose :global(h3) {
		margin-top: 1.8em;
		margin-bottom: 0.4em;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.prose :global(p + p) {
		margin-top: 1em;
	}

	.prose :global(ul) {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		margin-block: 0.8em 1em;
	}

	.prose :global(li) {
		position: relative;
		padding-left: 1.4em;
	}

	.prose :global(li::before) {
		content: '';
		position: absolute;
		top: 0.78em;
		left: 0.15em;
		width: 0.45em;
		height: 1.5px;
		background: var(--ink-3);
	}

	.prose :global(strong) {
		color: var(--ink);
		font-weight: 600;
	}

	.prose :global(em) {
		color: var(--ink);
	}

	.pager {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		padding-block: clamp(72px, 10vw, 140px);
	}

	.pager a {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}

	.pager .next {
		grid-column: 2;
		align-items: flex-end;
		text-align: right;
	}

	.label {
		color: var(--ink-3);
	}

	.pager-title {
		display: flex;
		align-items: baseline;
		gap: 0.3em;
		max-width: 100%;
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.pager-title .vt {
		display: inline-block;
		min-width: 0;
	}

	.pager .arrow {
		color: var(--ink-3);
		transition:
			transform 300ms var(--ease-out),
			color 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.pager a:hover .arrow {
			color: var(--ink);
		}

		.pager .next:hover .arrow {
			transform: translateX(6px);
		}

		.pager .prev:hover .arrow {
			transform: translateX(-6px);
		}
	}

	@media (max-width: 640px) {
		.pager {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}

		.pager .next {
			grid-column: 1;
		}

		.pager-title {
			font-size: 2rem;
		}
	}

	@media (max-width: 860px) {
		.case-head {
			grid-template-columns: minmax(0, 1fr);
		}

		.num {
			padding-top: 0;
		}

		.tagline,
		.notice {
			grid-column: 1;
		}

		.case-body {
			grid-template-columns: minmax(0, 1fr);
		}

		.facts {
			position: static;
		}
	}
</style>
