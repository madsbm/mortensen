---
import Base from '../layouts/Base.astro';
import { homePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = 'en';
const t = useTranslations(lang).notFound;
---

<Base lang={lang} title={t.title} crumbs={[{ label: '404', href: '/404', current: true }]}>
	<section class="container missing">
		<p class="mono code">{t.code}</p>
		<h1>{t.heading}</h1>
		<p class="note">{t.note}</p>
		<a class="button button-solid" href={homePath(lang)}>{t.back} <span class="arrow" aria-hidden="true">→</span></a>
	</section>
</Base>

<style>
	.missing {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 24px;
		min-height: 88svh;
		padding-top: 120px;
	}

	.code {
		color: var(--accent-ink);
	}

	h1 {
		max-width: 14ch;
		font-size: clamp(2.75rem, 7vw, 6rem);
		font-weight: 500;
		line-height: 0.95;
		letter-spacing: -0.05em;
	}

	.note {
		color: var(--ink-2);
		font-size: 1.125rem;
	}
</style>
