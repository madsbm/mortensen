---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CanvasFx from '../components/CanvasFx.astro';
import ProjectCover from '../components/ProjectCover.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');

const highlights = [
	{ value: '7,500', unit: 'concurrent users', text: 'Reworked a live quiz system to handle them.' },
	{ value: '20M DKK', unit: 'annual recurring revenue', text: 'Engineering on a car-booking platform at that scale.' },
	{ value: '50+ → 0', unit: 'observed malicious requests / sec', text: 'Internal systems that used to be reachable from the internet, before and after the Zero Trust rollout.' },
];

const toolkit = [
	{ group: 'Systems', items: ['Rust', 'x86_64', 'Linux', 'Memory management', 'Concurrency', 'Network protocols'] },
	{ group: 'Infrastructure & security', items: ['Cloudflare Zero Trust', 'Entra ID · OIDC · SCIM', 'mTLS', 'Smallstep SSH', 'Docker', 'Kubernetes', 'CI/CD'] },
	{ group: 'Applications', items: ['TypeScript', 'Java · Netty', 'Laravel', 'Databases', 'Performance tuning'] },
];
---

<Base spy>
	<section class="hero" aria-labelledby="hero-title">
		<CanvasFx
			effect="glass"
			sizing="fill"
			nativeOnly
			media="(hover: hover) and (pointer: fine) and (min-width: 768px) and (prefers-reduced-motion: no-preference)"
			class="hero-fx"
			options={{ size: 110, zoom: 1.35, targets: '[data-glass-target]', shine: 0.35, aberration: 0.8, follow: 0.22 }}
		>
			<div class="container hero-inner">
				<p class="eyebrow mono"><span class="dot" aria-hidden="true"></span>{site.role} · {site.location}</p>
				<h1 id="hero-title" class="display" data-glass-target>
					Low-level by choice.<br />
					<span class="muted">Full-stack by trade.</span>
				</h1>
				<div class="hero-foot">
					<p class="lede">
						I'm Mads, a software engineer focused on systems programming, concurrency and networking.
						By day I build and harden production platforms at Side-Walk. After hours I'm writing tOS, a
						bare-metal x86_64 operating system in Rust.
					</p>
					<div class="actions">
						<a class="button button-solid" href="#work">See the work <span class="arrow" aria-hidden="true">↓</span></a>
						<a class="button button-ghost" href="#contact">Get in touch</a>
					</div>
				</div>
			</div>
		</CanvasFx>
	</section>

	<section id="work" class="container section" data-section="work" aria-labelledby="work-title">
		<div class="section-head">
			<h2 id="work-title">Selected work</h2>
			<span class="mono">{pad(projects.length)} projects</span>
		</div>

		<ol class="projects">
			{
				projects.map((project) => (
					<li class="project">
						<span class="num mono vt" style={`--vt: num-${project.id}`} data-vt-project={project.id}>
							{pad(project.data.order)}
						</span>
						<div class="project-text">
							<h3 class="project-title">
								<a href={`/work/${project.id}`}>
									<span class="vt" style={`--vt: title-${project.id}`} data-vt-project={project.id}>
										{project.data.title}
									</span>
								</a>
							</h3>
							<p class="tagline">{project.data.tagline}</p>
							<ul class="tags mono" aria-label="Topics">
								{project.data.tags.map((tag) => <li>{tag}</li>)}
							</ul>
							<span class="open" aria-hidden="true">
								Read the case study <span class="arrow">→</span>
							</span>
						</div>
						<ProjectCover id={project.id} kind={project.data.cover} class="project-cover" />
					</li>
				))
			}
		</ol>
	</section>

	<section id="about" class="container section" data-section="about" aria-labelledby="about-title">
		<div class="section-head">
			<h2 id="about-title">About</h2>
			<span class="mono">Software Engineer at Side-Walk ApS</span>
		</div>

		<div class="about-grid">
			<div class="bio">
				<p class="bio-lead">
					I like problems where correctness and performance both matter, and I like owning them end to
					end.
				</p>
				<p>
					At Side-Walk I work across the whole lifecycle: architecture, implementation, deployment,
					maintenance and optimisation. That includes independent audits and takeovers of unfamiliar
					codebases for larger companies, including Grant Thornton, and performance work on Laravel
					applications, database queries and game servers.
				</p>
				<p>
					I also designed and rolled out the security architecture for our internal systems:
					Cloudflare Zero Trust, Microsoft Entra ID over OIDC with SCIM provisioning and role-based
					access, mTLS for client websites, and Smallstep SSH certificates in place of hardcoded keys.
				</p>
				<p class="mono tenure">Part-time through high school · full-time since 2026</p>
			</div>

			<ul class="highlights">
				{
					highlights.map((item) => (
						<li>
							<span class="value">{item.value}</span>
							<span class="unit mono">{item.unit}</span>
							<span class="text">{item.text}</span>
						</li>
					))
				}
			</ul>
		</div>

		<dl class="toolkit">
			{
				toolkit.map((row) => (
					<div>
						<dt class="mono">{row.group}</dt>
						<dd>{row.items.join(', ')}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section id="contact" class="container section" data-section="contact" aria-labelledby="contact-title">
		<div class="section-head">
			<h2 id="contact-title">Contact</h2>
			<span class="mono">{site.location}</span>
		</div>
		<ContactForm />
	</section>
</Base>

<style>
	/* ---------------------------------------------------------------- hero */

	.hero {
		min-height: 100svh;
	}

	.hero :global(.hero-fx) {
		min-height: inherit;
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: clamp(28px, 4vw, 48px);
		min-height: 100svh;
		padding-top: 120px;
		padding-bottom: clamp(40px, 7vh, 88px);
	}

	@media (min-width: 768px) {
		/* The html-in-canvas source needs a definite height. */
		.hero,
		.hero :global(.hero-fx) {
			height: clamp(640px, 100svh, 980px);
			min-height: 0;
		}

		.hero-inner {
			height: 100%;
			min-height: 0;
		}
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--ink-2);
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.display {
		font-size: clamp(3rem, 8.4vw, 7.5rem);
		font-weight: 500;
		line-height: 0.94;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}

	.muted {
		color: var(--ink-3);
	}

	.hero-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 28px 48px;
		padding-top: clamp(24px, 3vw, 36px);
		border-top: 1px solid var(--line);
	}

	.lede {
		max-width: 52ch;
		color: var(--ink-2);
		font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	/* ------------------------------------------------------------- sections */

	.section {
		padding-top: clamp(72px, 10vw, 140px);
	}

	.section:last-of-type {
		padding-bottom: clamp(72px, 10vw, 140px);
	}

	/* ------------------------------------------------------------- projects */

	.project {
		position: relative;
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.3fr);
		gap: clamp(20px, 3vw, 40px);
		padding-block: clamp(28px, 4vw, 48px);
		border-bottom: 1px solid var(--line);
	}

	.num {
		align-self: start;
		padding-top: 0.9em;
		color: var(--ink-3);
		transition: color 200ms ease;
	}

	.project-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.project-title {
		font-size: clamp(2.25rem, 4.6vw, 3.75rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.project-title span {
		display: inline-block;
	}

	/* The title link covers the whole row. */
	.project-title a::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.project-title a:focus-visible {
		outline: none;
	}

	.project:has(a:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 6px;
		border-radius: 8px;
	}

	.tagline {
		max-width: 30ch;
		color: var(--ink-2);
		font-size: 1.125rem;
		line-height: 1.45;
		text-wrap: pretty;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.tags li {
		padding: 4px 10px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-2);
		font-size: 0.75rem;
	}

	.open {
		display: inline-flex;
		gap: 8px;
		margin-top: auto;
		padding-top: 12px;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.open .arrow,
	.project :global(.project-cover .frame) {
		transition: transform 300ms var(--ease-out);
	}

	.project:active :global(.project-cover .frame) {
		transform: scale(0.99);
	}

	@media (hover: hover) and (pointer: fine) {
		.project:hover .num {
			color: var(--accent-ink);
		}

		.project:hover .open .arrow {
			transform: translateX(3px);
		}

		.project:hover :global(.project-cover .frame) {
			transform: scale(1.012);
		}
	}

	@media (max-width: 900px) {
		.project {
			grid-template-columns: minmax(0, 1fr);
			gap: 18px;
		}

		.num {
			padding-top: 0;
		}

		.project :global(.project-cover) {
			order: -1;
		}
	}

	/* ---------------------------------------------------------------- about */

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: clamp(40px, 6vw, 96px);
		padding-top: clamp(32px, 4vw, 48px);
	}

	.bio {
		display: flex;
		flex-direction: column;
		gap: 18px;
		color: var(--ink-2);
		font-size: 1.0625rem;
		line-height: 1.65;
	}

	.bio-lead {
		max-width: 22ch;
		color: var(--ink);
		font-size: clamp(1.625rem, 2.8vw, 2.25rem);
		line-height: 1.12;
		letter-spacing: -0.03em;
		font-weight: 500;
	}

	.bio p:not(.bio-lead, .tenure) {
		max-width: 60ch;
	}

	.tenure {
		color: var(--ink-3);
	}

	.highlights {
		display: flex;
		flex-direction: column;
		align-self: start;
		border-top: 1px solid var(--line);
	}

	.highlights li {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 6px;
		padding-block: 22px;
		border-bottom: 1px solid var(--line);
	}

	.value {
		font-size: clamp(2rem, 3.4vw, 2.75rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
	}

	.unit {
		color: var(--ink-3);
	}

	.text {
		color: var(--ink-2);
	}

	.toolkit {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
		margin-top: clamp(48px, 6vw, 80px);
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}

	.toolkit div {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.toolkit dt {
		color: var(--ink-3);
	}

	.toolkit dd {
		color: var(--ink);
		line-height: 1.6;
	}

	@media (max-width: 860px) {
		.about-grid,
		.toolkit {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
